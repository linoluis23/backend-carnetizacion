		{
			"name": "🛡️ Gestión de Tokens",
			"item": [
				{
					"name": "✅ Verificar Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Token válido confirmado', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.valid).to.be.true;",
									"});",
									"",
									"pm.test('Información del token incluida', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.token).to.have.property('remainingTime');",
									"    pm.expect(jsonData.data.token).to.have.property('expiresInSeconds');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/verify",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"verify"
							]
						},
						"description": "Verifica si un token JWT es válido y retorna información detallada.\n\n**Parámetros opcionales:**\n- `?checkUser=false` - No verifica usuario en BD (más rápido)\n\n**Información retornada:**\n- Datos del usuario\n- Tiempo de emisión y expiración\n- Tiempo restante formateado\n- Segundos hasta expiración"
					},
					"response": [
						{
							"name": "Token Válido",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"data\": {\n    \"valid\": true,\n    \"user\": {\n      \"id\": 1,\n      \"email\": \"maria.garcia@empresa.com\",\n      \"nombres\": \"María José\",\n      \"estado_usuario\": \"ACT\"\n    },\n    \"token\": {\n      \"issuedAt\": \"2024-01-15T10:30:00.000Z\",\n      \"expiresAt\": \"2024-01-16T10:30:00.000Z\",\n      \"remainingTime\": \"23h 45m 30s\",\n      \"expiresInSeconds\": 85530\n    }\n  },\n  \"message\": \"Token válido\"\n}"
						},
						{
							"name": "Token Expirado",
							"status": "Unauthorized",
							"code": 401,
							"body": "{\n  \"success\": false,\n  \"error\": \"El token ha expirado\",\n  \"code\": \"TOKEN_EXPIRED\"\n}"
						},
						{
							"name": "Token Inválido",
							"status": "Unauthorized",
							"code": 401,
							"body": "{\n  \"success\": false,\n  \"error\": \"Token inválido\",\n  \"code\": \"TOKEN_INVALID\"\n}"
						}
					]
				},
				{
					"name": "🔄 Refrescar Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Si se generó nuevo token, actualizarlo",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.refreshed) {",
									"        pm.environment.set('token', jsonData.data.newToken);",
									"        console.log('🔄 Token actualizado automáticamente');",
									"    } else {",
									"        console.log('✅ Token aún válido, no necesita refresco');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"threshold\": 300\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"refresh"
							]
						},
						"description": "Verifica el token y lo refresca si está cerca de expirar.\n\n**Parámetros:**\n- `threshold`: Segundos antes de expirar para refrescar (default: 300 = 5 min)\n\n**Respuesta:**\n- Si se refrescó: incluye `newToken`\n- Si no necesita: `refreshed: false`"
					},
					"response": [
						{
							"name": "Token Refrescado",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"data\": {\n    \"valid\": true,\n    \"user\": { ... },\n    \"token\": { ... },\n    \"refreshed\": true,\n    \"newToken\": \"eyJhbGciOi...\"\n  },\n  \"message\": \"Token refrescado exitosamente\"\n}"
						},
						{
							"name": "Token Aún Válido",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"data\": {\n    \"valid\": true,\n    \"user\": { ... },\n    \"token\": { ... },\n    \"refreshed\": false,\n    \"newToken\": null\n  },\n  \"message\": \"Token aún válido\"\n}"
						}
					]
				},
				{
					"name": "🔍 Decodificar Token (Debug)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/decode",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"decode"
							]
						},
						"description": "Decodifica un token JWT sin verificar su firma (solo para debugging).\n\n⚠️ **No usar en producción.**\n\n**Útil para:**\n- Ver el payload sin validar firma\n- Diagnosticar tokens malformados\n- Verificar claims del token"
					},
					"response": [
						{
							"name": "Token Decodificado",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"data\": {\n    \"header\": {\n      \"alg\": \"HS256\",\n      \"typ\": \"JWT\"\n    },\n    \"payload\": {\n      \"id\": 1,\n      \"email\": \"maria.garcia@empresa.com\",\n      \"iat\": 1700000000,\n      \"exp\": 1700086400\n    },\n    \"signature\": \"abc123...\"\n  }\n}"
						}
					]
				},
				{
					"name": "🧪 Test Token Manual",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/test-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"test-token"
							]
						},
						"description": "Endpoint de diagnóstico para probar tokens manualmente.\n\n**Utilidad:**\n- Verificar por qué un token falla\n- Obtener información detallada del error\n- Ver payload decodificado incluso si el token es inválido"
					},
					"response": []
				}
			]
		},
